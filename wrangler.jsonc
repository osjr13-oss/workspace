{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "selrano",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "selrano" }
  ],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 13 * * *", "0 14 * * *"]
  },
  "routes": [
    { "pattern": "www.selrano.com/*", "zone_name": "selrano.com" },
    { "pattern": "selrano.com/*", "zone_name": "selrano.com" }
  ],
  "workers_dev": true,
  "preview_urls": false
}

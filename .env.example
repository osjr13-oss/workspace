NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Gemini powers all AI and Google Search grounding. Use a billing-enabled project.
GEMINI_API_KEY=
# Optional overrides; default gemini-3.6-flash for both.
GEMINI_MODEL=
GEMINI_BACKGROUND_MODEL=
# Selrano is private: comma-separated emails that may sign in.
ALLOWED_EMAILS=

# Branding
NEXT_PUBLIC_APP_URL=https://selrano.com

# Email (Resend) - see docs/SETUP.md Step 4
RESEND_API_KEY=
EMAIL_FROM=Selrano <noreply@selrano.com>
# Random string; the daily lifecycle email job checks it
CRON_SECRET=

# Stripe billing (Pro founding $6.99/mo) - see docs/BILLING.md
# STRIPE_PRO_PRICE_ID must be a monthly price of 699 cents; checkout validates this.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq is the only model provider. GROQ_MODEL must be a real Groq model id.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Web search. When this is empty, search tells the person it is off.
TAVILY_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Welcome and lifecycle mail. Signup still works when this is empty.
RESEND_API_KEY=
EMAIL_FROM=Selrano <noreply@selrano.com>

# Required by /api/cron/lifecycle-emails. Vercel sends it as a bearer token.
CRON_SECRET=

# Pro checkout from the account menu. Price must be a $6.99 monthly price.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

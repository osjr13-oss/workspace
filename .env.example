NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
# Primary AI: OpenAI GPT (chat, meal estimates, food photos). Groq remains the fallback and runs background work.
OPENAI_API_KEY=
# Optional override; default gpt-6.1-sol.
OPENAI_MODEL=
# Optional reasoning effort (for example low); blank uses the model default.
OPENAI_REASONING_EFFORT=
# Selrano is private: comma-separated emails that may sign in. Empty lets nobody in.
ALLOWED_EMAILS=
# Optional model overrides; blank uses the defaults. Groq retires models, see https://console.groq.com/docs/deprecations
GROQ_MODEL=
# How hard chat answers think on gpt-oss models: low, medium (default), or high. Higher is smarter but slower to start.
GROQ_REASONING_EFFORT=
GROQ_FALLBACK_MODEL=
GROQ_BACKGROUND_MODEL=
GROQ_VISION_MODEL=
# Live web search in chat
TAVILY_API_KEY=

# Branding
NEXT_PUBLIC_APP_URL=https://selrano.com

# Email (Resend) - see docs/SETUP.md Step 4
RESEND_API_KEY=
EMAIL_FROM=Selrano <noreply@selrano.com>
# Random string; the daily lifecycle email job checks it
CRON_SECRET=

# Stripe billing (Pro founding $6.99/mo) - see docs/BILLING.md
# STRIPE_PRO_PRICE_ID must be a monthly price of 699 cents; checkout validates this.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Optional
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

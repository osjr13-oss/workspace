# Private access: comma-separated emails allowed to sign in. Empty lets nobody in.
ALLOWED_EMAILS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Dedicated lock for stored Google and bank logins (48+ random characters). See docs/SETUP.md Step 4d. Never lose it.
TOKEN_ENCRYPTION_KEY=
GROQ_API_KEY=
# Primary AI: OpenAI GPT for chat. Groq remains the fallback and runs background work, transformations and OCR.
OPENAI_API_KEY=
# Optional override; default gpt-6.1-sol.
OPENAI_MODEL=
# Optional reasoning effort (for example low); blank uses the model default.
OPENAI_REASONING_EFFORT=
# Optional model overrides; blank uses the defaults. Groq retires models, see https://console.groq.com/docs/deprecations
GROQ_MODEL=
# How hard chat answers think on gpt-oss models: low, medium (default), or high. Higher is smarter but slower to start.
GROQ_REASONING_EFFORT=
GROQ_FALLBACK_MODEL=
GROQ_BACKGROUND_MODEL=
GROQ_VISION_MODEL=
# Live web search in chat
EXA_API_KEY=
# Optional: connect Gmail and Google Calendar (Settings > Connected accounts). See docs/SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: personal finance through Plaid (Money page). PLAID_ENV is sandbox (test bank) or production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Branding
NEXT_PUBLIC_APP_URL=https://selrano.com

# Email (Resend), used only for the opt-in weekly summary - see docs/SETUP.md Step 4
RESEND_API_KEY=
EMAIL_FROM=Selrano <noreply@selrano.com>
# Random string; the daily scheduled jobs check it
CRON_SECRET=

# Optional
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

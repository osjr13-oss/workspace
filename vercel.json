{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/lifecycle-emails",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/grounded-history",
      "schedule": "0 13 * * *"
    }
  ]
}

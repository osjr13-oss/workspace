{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "../lib/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../lib/chat-stream.ts",
    "../lib/stream-markdown.ts",
    "../lib/stream-pacer.ts",
    "../lib/text.ts",
    "../lib/types.ts"
  ]
}
